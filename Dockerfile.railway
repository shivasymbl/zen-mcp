# Stage 1: Python deps
FROM python:3.11-slim AS builder
RUN apt-get update && apt-get install -y build-essential curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

# Stage 2: Runtime with Node for supergateway
FROM python:3.11-slim AS runtime
RUN apt-get update && apt-get install -y ca-certificates curl && \
    curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /app
COPY . .
RUN npm install -g supergateway@3.4.3 && mkdir -p logs tmp
RUN groupadd -r mcpuser && useradd -r -g mcpuser mcpuser && chown -R mcpuser:mcpuser /app
USER mcpuser

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV PORT=8080

EXPOSE 8080
# --stateful: one child per session, not one per request
# --keepAliveInterval 30000: SSE pings keep session alive while client connected
# --sessionTimeout 3600000: 1h fallback timeout if client disconnects silently
CMD ["sh", "-c", "supergateway \
  --port ${PORT:-8080} \
  --outputTransport streamableHttp \
  --stateful \
  --keepAliveInterval 30000 \
  --sessionTimeout 3600000 \
  --healthEndpoint /health \
  --oauth2Bearer \"${MCP_AUTH_TOKEN}\" \
  --stdio 'exec python server.py'"]

