# Stage 1: Python deps
FROM python:3.13-slim AS builder
RUN apt-get update && apt-get install -y build-essential curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip && \
    /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

# Stage 2: Runtime with Node for supergateway
FROM python:3.13-slim AS runtime
RUN apt-get update && apt-get install -y ca-certificates curl && \
    curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /app
COPY . .
RUN npm install -g supergateway@4.2.0 && mkdir -p logs tmp
RUN groupadd -r mcpuser && useradd -r -g mcpuser mcpuser && chown -R mcpuser:mcpuser /app
USER mcpuser

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app
ENV PORT=8080

EXPOSE 8080
# --stateful: one child per session, not one per request
# --sessionTimeout 3600000: 1h fallback timeout if client disconnects silently
# Auth: SUPERGATEWAY_API_KEY is required; clients send "Authorization: Bearer <key>" (or X-API-Key).
# Fail closed: unset/blank key exits 1 before listening (supergateway alone treats unset as open).
# /health stays open for the Railway healthcheck.
CMD ["sh", "-c", "case ${SUPERGATEWAY_API_KEY:-} in *[![:space:]]*) ;; *) echo 'FATAL: SUPERGATEWAY_API_KEY is unset or blank; refusing to start an unauthenticated gateway.' >&2; exit 1;; esac; \
  supergateway \
  --port ${PORT:-8080} \
  --outputTransport streamableHttp \
  --stateful \
  --sessionTimeout 3600000 \
  --healthEndpoint /health \
  --stdio 'exec python server.py'"]

